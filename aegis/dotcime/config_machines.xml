<?xml version="1.0"?>
<!--
  Aegis user machine definition for E3SM/CIME (Phase 0: ELM on Apple silicon).
  Based on the upstream E3SM "mac" machine entry. All toolchain components
  (gcc/gfortran, clang, MPICH, HDF5, NetCDF-C/Fortran, PnetCDF, cmake, make,
  perl, python) come from the conda-forge env at AEGIS_E3SM_ENV below.
-->
<config_machines version="2.0">
  <machine MACH="aegis-mac">
    <DESC>Aegis Apple-silicon MacBook (osx-arm64), conda-forge gnu + MPICH toolchain</DESC>
    <NODENAME_REGEX>aegis-mac-never-auto-detect</NODENAME_REGEX>
    <OS>Darwin</OS>
    <COMPILERS>gnu</COMPILERS>
    <MPILIBS>mpich</MPILIBS>
    <CIME_OUTPUT_ROOT>/Volumes/SSD-Data/aegis-data/e3sm-work/scratch</CIME_OUTPUT_ROOT>
    <DIN_LOC_ROOT>/Volumes/SSD-Data/aegis-data/e3sm-work/inputdata</DIN_LOC_ROOT>
    <DIN_LOC_ROOT_CLMFORC>/Volumes/SSD-Data/aegis-data/e3sm-work/inputdata/atm/datm7</DIN_LOC_ROOT_CLMFORC>
    <DOUT_S_ROOT>/Volumes/SSD-Data/aegis-data/e3sm-work/scratch/archive/$CASE</DOUT_S_ROOT>
    <BASELINE_ROOT>/Volumes/SSD-Data/aegis-data/e3sm-work/baselines/$COMPILER</BASELINE_ROOT>
    <GMAKE>make</GMAKE>
    <GMAKE_J>6</GMAKE_J>
    <TESTS>e3sm_land_developer</TESTS>
    <BATCH_SYSTEM>none</BATCH_SYSTEM>
    <SUPPORTED_BY>jinwoong.yoo at nasa dot gov</SUPPORTED_BY>
    <MAX_TASKS_PER_NODE>6</MAX_TASKS_PER_NODE>
    <MAX_MPITASKS_PER_NODE>6</MAX_MPITASKS_PER_NODE>
    <mpirun mpilib="default">
      <executable>mpiexec</executable>
      <arguments>
        <arg name="num_tasks"> -n {{ total_tasks }}</arg>
      </arguments>
    </mpirun>
    <module_system type="none"/>
    <RUNDIR>$CIME_OUTPUT_ROOT/$CASE/run</RUNDIR>
    <EXEROOT>$CIME_OUTPUT_ROOT/$CASE/bld</EXEROOT>
    <environment_variables>
      <env name="AEGIS_E3SM_ENV">/Volumes/SSD-Data/aegis-data/conda-envs/e3sm</env>
      <env name="PATH">/Volumes/SSD-Data/aegis-data/conda-envs/e3sm/bin:/usr/bin:/bin:/usr/sbin:/sbin</env>
      <env name="NETCDF_PATH">/Volumes/SSD-Data/aegis-data/conda-envs/e3sm</env>
      <env name="NETCDF_C_PATH">/Volumes/SSD-Data/aegis-data/conda-envs/e3sm</env>
      <env name="NETCDF_FORTRAN_PATH">/Volumes/SSD-Data/aegis-data/conda-envs/e3sm</env>
      <env name="PNETCDF_PATH">/Volumes/SSD-Data/aegis-data/conda-envs/e3sm</env>
      <env name="HDF5_ROOT">/Volumes/SSD-Data/aegis-data/conda-envs/e3sm</env>
      <env name="MOAB_ROOT">/Volumes/SSD-Data/aegis-data/conda-envs/e3sm</env>
      <env name="LAPACK_ROOT">/Volumes/SSD-Data/aegis-data/conda-envs/e3sm</env>
      <env name="TMPDIR">/Volumes/SSD-Data/aegis-data/e3sm-work/tmp</env>
      <!-- conda-forge MPICH (ch4:ofi): the default libfabric provider hangs in
           MPI_Finalize on macOS; the tcp provider works. -->
      <env name="FI_PROVIDER">tcp</env>
    </environment_variables>
  </machine>
</config_machines>
